<record id="real_estate_property_offer_view_list" model="ir.ui.view">
    <field name="name">x_estate.property.offer.list</field>
    <field name="model">x_estate.property.offer</field>
    <field name="arch" type="xml">
        <list>
            <field name="x_price"/>
            <field name="x_partner_id"/>
            <field name="x_status"/>
        </list>
    </field>
</record>

<record id="real_estate_property_offer_view_form" model="ir.ui.view">
    <field name="name">x_estate.property.offer.form</field>
    <field name="model">x_estate.property.offer</field>
    <field name="arch" type="xml">
        <form>
            <group>
                <field name="x_price"/>
                <field name="x_partner_id"/>
                <field name="x_status"/>
            </group>
        </form>
    </field>
</record>