<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_property_view_list" model="ir.ui.view">
        <field name="name">x_estate.property.list</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_postcode"/>
                <field name="x_bedrooms"/>
                <field name="x_expected_price"/>
                <field name="x_selling_price"/>
            </list>
        </field>
    </record>

    <record id="real_estate_property_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.form</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name"/>
                        <field name="x_postcode"/>
                        <field name="x_date_availability"/>
                        <field name="x_expected_price"/>
                        <field name="x_selling_price"/>
                        <field name="x_bedrooms"/>
                        <field name="x_living_area"/>
                        <field name="x_facades"/>
                        <field name="x_garage"/>
                        <field name="x_garden"/>
                        <field name="x_garden_area"/>
                        <field name="x_garden_orientation"/>
                        <field name="x_property_tag_ids" widget="many2many_tags"/>
                        <field name="x_total_area"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="x_description"/>
                        </page>
                        <page string="Offers">
                        <field name="x_offer_ids">
                            <list>
                                <field name="x_price"/>
                                <field name="x_partner_id"/>
                                <field name="x_status"/>
                                <button name="estate.action_x_estate_property_offer_accept" type="action" string="Accept" icon="fa-check"/>
                            </list>
                        </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">x_estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>