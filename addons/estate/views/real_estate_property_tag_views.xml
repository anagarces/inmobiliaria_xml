        <field name="res_model">x_estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="real_estate_menu_property_tags" name="Property Tags" parent="real_estate_menu_root" action="action_real_estate_property_tag"/>
</odoo>