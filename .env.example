# ============================================================
#  Plantilla de variables de entorno
#  Copia este archivo a .env y rellena con valores reales:
#     cp .env.example .env
#  El archivo .env esta en .gitignore y NO debe subirse a GitHub.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia_esta_password_de_postgres
PGDATA=/var/lib/postgresql/data/pgdata

# ---- Odoo ----
# Contrasena maestra para crear/gestionar bases de datos desde la UI
ODOO_MASTER_PASSWORD=cambia_esta_password_maestra_de_odoo

# Puerto expuesto en el host para acceder a Odoo (http://localhost:PUERTO)
ODOO_PORT=8069
# Puerto para conexiones longpolling / websocket (chat, notificaciones)
ODOO_LONGPOLLING_PORT=8072

# Nivel de log: debug, info, warn, error
ODOO_LOG_LEVEL=info
